def repoUrl = scm.getUserRemoteConfigs()[0].getUrl()
env.owner = "Nishanth"
podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  containers:
  - name: git
    image: alpine/git:latest
    command:
    - cat
    tty: true
    securityContext:
      privileged: true
''' 
) {
    node(POD_LABEL) {
        container('git') {
            stage('Print Env') {
                checkout scm

                sh """
                  echo "owner: \$owner"
                  echo "repoUrl: ${repoUrl}"
                """
            }
        }
    }
   
}