podTemplate(yaml: '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins: agent
spec:
  containers:
  - name: git
    image: alpine/git:latest
    command:
    - cat
    tty: true
    securityContext:
      privileged: true
''' 
) {
    node(POD_LABEL) {
        container('git') {
            stage('Print Env') {
                checkout scm

                sh '''
                  echo "build number: $BUILD_NUMBER"
                  echo "job name: $JOB_NAME"
                  echo "workspace: $WORKSPACE"
                  echo "git url: $GIT_URL"
                  echo "git branch: $GIT_BRANCH"
                '''
            }
        }
    }
   
}